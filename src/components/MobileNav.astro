---
import { getEntry } from "astro:content";
import { type Locale, localizePath, t } from "@/i18n";
import IconButton from "./common/IconButton.astro";
import Icon from "./common/Icon.astro";
import ButtonLink from "./common/ButtonLink.astro";
import DarkMode from "./DarkMode.astro";
import MobileNavLink from "./MobileNavLink.astro";
import Logo from "./Logo.astro";
import IconButtonLink from "./common/IconButtonLink.astro";

const lang = (Astro.currentLocale ?? "es") as Locale;
const author = await getEntry("authorInfo", `${lang}/jeantivan`);
---

<div class="md:hidden">
  <div class="flex justify-between gap-6 items-center py-2">
    <IconButton id="open-nav" label={t("NavBar_mobile_open", undefined, lang)}>
      <Icon label="Icon" icon="list" />
    </IconButton>
    <Logo mobile />
    <ButtonLink
      href={author?.data?.cv ? `${author.data.cv}?dl=` : "#"}
      target="_blank"
      rel="noopener noreferrer"
    >
      {t("NavBar_cv", undefined, lang)}
      <Icon label="Download" icon="download" />
    </ButtonLink>
  </div>
  <div id="nav-container" class="hidden fixed inset-0 z-50">
    <div
      class="bg-background-2 p-3 w-full h-full grid grid-rows-[min-content_1fr_min-content]"
    >
      <header class="flex gap-6 items-center justify-between py-2">
        <IconButton
          id="close-nav"
          label={t("NavBar_mobile_close", undefined, lang)}
        >
          <Icon
            size="18px"
            label={`${t("NavBar_mobile_close", undefined, lang)} icon`}
            icon="close"
          />
        </IconButton>
        <DarkMode mobile />
      </header>
      <nav class="flex flex-col justify-center items-center w-full gap-8">
        <MobileNavLink href={localizePath("/", lang)}>
          {t("NavBar_links_aboutMe", undefined, lang)}
        </MobileNavLink>
        <MobileNavLink href={localizePath("/skills", lang)}>
          {t("NavBar_links_skills", undefined, lang)}
        </MobileNavLink>
        <MobileNavLink href={localizePath("/projects", lang)}>
          {t("NavBar_links_projects", undefined, lang)}
        </MobileNavLink>
        <MobileNavLink href={localizePath("/contact", lang)}>
          {t("NavBar_links_contact", undefined, lang)}
        </MobileNavLink>
      </nav>
      <footer class="flex gap-6 justify-center py-3">
        <IconButtonLink
          href={author?.data?.social?.linkedIn ?? "#"}
          label={t("NavBar_mobile_linkedin", undefined, lang)}
        >
          <Icon
            size="18px"
            icon="linkedin-logo"
            label={t("NavBar_mobile_linkedin", undefined, lang)}
          />
        </IconButtonLink>
        <IconButtonLink
          href={author?.data?.social?.github ?? "#"}
          label={t("NavBar_mobile_github", undefined, lang)}
        >
          <Icon
            size="18px"
            icon="github-logo"
            label={t("NavBar_mobile_github", undefined, lang)}
          />
        </IconButtonLink>
      </footer>
    </div>
  </div>
</div>

<script is:inline>
  const openButton = document.getElementById("open-nav");
  const closeButton = document.getElementById("close-nav");
  const navContainer = document.getElementById("nav-container");
  const body = document.body;
  const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");

  openButton?.addEventListener("click", () => {
    navContainer?.classList.remove("hidden");
    body.classList.add("overflow-hidden");
    closeButton?.focus();
  });

  closeButton?.addEventListener("click", () => {
    navContainer?.classList.add("hidden");
    body.classList.remove("overflow-hidden");
    openButton?.focus();
  });

  mobileNavLinks.forEach((link) =>
    link.addEventListener("click", () => {
      navContainer?.classList.add("hidden");
      body.classList.remove("overflow-hidden");
    }),
  );
</script>
