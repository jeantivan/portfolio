---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { type Locale, getPageSeo, localizePath, t } from "@/i18n";
import { getProfile } from "@/content/profile";
import { getFeaturedTechnologies } from "@/content/skills";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/common/Container.astro";
import Text from "@/components/common/Text.astro";
import Icon from "@/components/common/Icon.astro";
import Card from "@/components/common/Card.astro";
import ButtonLink from "@/components/common/ButtonLink.astro";
import Heading from "@/components/Heading.astro";
import TechnologyIcon from "@/components/TechnologyIcon.astro";
import Project from "@/components/Project.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const seo = getPageSeo("about", lang);
const profile = await getProfile();

const isFeaturedProjectForLocale =
  (locale: Locale) =>
  ({
    data,
    id,
  }: {
    data: { language?: string; featured: boolean; type?: string };
    id: string;
  }) => {
    const matchesLocale =
      id.startsWith(`${locale}/`) || data.language === locale;
    return matchesLocale && data.featured && data.type !== "42";
  };

const projectsInLang = await getCollection(
  "project",
  isFeaturedProjectForLocale(lang),
);

const projectsToShow =
  projectsInLang.length > 0
    ? projectsInLang
    : await getCollection("project", isFeaturedProjectForLocale("es"));

const featuredTechnologies = getFeaturedTechnologies(
  await getCollection("technology"),
);

const [firstName, ...restName] = profile.data.name.split(" ");
const nameFormatted =
  restName.length > 0 ? `${firstName} <br />${restName.join(" ")}` : firstName;
const bioParagraphs = profile.data.bio[lang].split("\n\n");
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
>
  <Container class="px-3 py-6 lg:py-10 grid gap-16 md:gap-24">
    <section>
      <div class="mb-4 flex flex-col md:flex-row gap-6">
        <div class="shrink-0 flex flex-col">
          <Text as="h1" variant="main" weight="bold" class="uppercase mb-2.5">
            <Fragment set:html={nameFormatted} />
          </Text>
          <Text
            as="h2"
            variant="title"
            weight="medium"
            class="uppercase text-primary-11 dark:text-primary-9"
            display
          >
            {profile.data.profession[lang]}
          </Text>
        </div>
      </div>
      <Text variant="subheading" weight="light" color="secondary">
        {t("AboutMePage_main_content", undefined, lang)}
      </Text>
    </section>

    <section class="grid gap-6 md:gap-8">
      <Heading
        text={t("AboutMePage_projects_title", undefined, lang)}
        as="h3"
        variant="title"
        class="flex-1 text-center"
      />
      <div class="flex flex-wrap justify-center gap-3">
        {projectsToShow.map((proj) => <Project project={proj} />)}
      </div>
      <div class="flex justify-center">
        <ButtonLink
          class="w-full max-w-lg"
          variant="outlined"
          href={localizePath("/projects", lang)}
        >
          {t("AboutMePage_projects_cta", undefined, lang)}
          <Icon label="Go to" icon="arrow-right" size="20px" />
        </ButtonLink>
      </div>
    </section>

    <section class="grid gap-6 md:gap-8">
      <Heading
        text={t("AboutMePage_skills_title", undefined, lang)}
        variant="heading"
        display
      />
      <div class="grid grid-cols-2 md:grid-cols-4 justify-between gap-3">
        {
          featuredTechnologies.map((technology) => (
            <Card class="max-w-60 bg-background-2 px-8 py-4">
              <TechnologyIcon size="auto" technology={technology} showName />
            </Card>
          ))
        }
      </div>
      <div class="flex justify-end">
        <ButtonLink
          variant="outlined"
          href={localizePath("/skills", lang)}
          class="w-full max-w-lg"
        >
          {t("AboutMePage_skills_cta", undefined, lang)}
          <Icon label="Arrow right icon" icon="arrow-right" size="20px" />
        </ButtonLink>
      </div>
    </section>

    <section class="grid grid-cols-11 gap-6 md:gap-10">
      <Heading
        class="col-span-11"
        text={t("AboutMePage_aboutMe_title", undefined, lang)}
        variant="heading"
        display
      />
      <div class="col-span-11 md:col-span-7">
        {
          bioParagraphs.map((paragraph) => (
            <Text class="mb-4 last:mb-0">{paragraph}</Text>
          ))
        }
      </div>
      <div class="col-span-11 md:col-span-4 md:-mt-20">
        <div class="bg-background-9 rounded-xl w-full overflow-hidden">
          <Image
            src={profile.data.picture.src}
            alt={profile.data.picture.alt[lang]}
            class="w-full aspect-[4/5]"
          />
        </div>
      </div>

      <div class="col-span-11 flex justify-end">
        <ButtonLink href={localizePath("/contact", lang)}>
          {t("AboutMePage_aboutMe_cta", undefined, lang)}
        </ButtonLink>
      </div>
    </section>
  </Container>
</BaseLayout>
