---
import { getEntry } from "astro:content";
import { type Locale, localizePath, t } from "@/i18n";
import ButtonLink from "./common/ButtonLink.astro";
import Icon from "./common/Icon.astro";
import Logo from "./Logo.astro";
import DarkMode from "./DarkMode.astro";
import DesktopNavLink from "./DesktopNavLink.astro";

const lang = (Astro.currentLocale ?? "es") as Locale;
const author = await getEntry("authorInfo", `${lang}/jeantivan`);
---

<div class="hidden flex-1 md:flex items-center">
  <Logo />
  <nav class="hidden md:flex flex-1 justify-end items-center gap-4">
    <DesktopNavLink href={localizePath("/", lang)}
      >{t("NavBar_links_aboutMe", undefined, lang)}</DesktopNavLink
    >
    <DesktopNavLink href={localizePath("/skills", lang)}
      >{t("NavBar_links_skills", undefined, lang)}</DesktopNavLink
    >
    <DesktopNavLink href={localizePath("/projects", lang)}
      >{t("NavBar_links_projects", undefined, lang)}</DesktopNavLink
    >
    <DesktopNavLink href={localizePath("/contact", lang)}
      >{t("NavBar_links_contact", undefined, lang)}</DesktopNavLink
    >
    <ButtonLink
      href={author?.data?.cv ? `${author.data.cv}?dl=` : "#"}
      target="_blank"
      rel="noopener noreferrer"
    >
      {t("NavBar_cv", undefined, lang)}
      <Icon label="Download" icon="download" />
    </ButtonLink>
    <div class="flex gap-2">
      <DarkMode />
    </div>
  </nav>
</div>
