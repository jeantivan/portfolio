---
import { type Locale, localizePath, t } from "@/i18n";
import { getProfile } from "@/content/profile";
import Text from "./common/Text.astro";
import Container from "./common/Container.astro";

const lang = (Astro.currentLocale ?? "es") as Locale;
const profile = await getProfile();

const esHref = localizePath(Astro.url.pathname, "es");
const enHref = localizePath(Astro.url.pathname, "en");
---

<Container
  class="grid grid-cols-12 gap-6 pt-8 pb-4 justify-between bg-background-2 dark:bg-background-1"
  as="footer"
>
  <Text
    class="col-span-12 md:col-span-8 text-center md:text-left"
    variant="subtitle"
    set:html={t(
      "Footer_github_cta",
      {
        githubUrl: profile.data.social.github,
      },
      lang,
    )}
  />
  <div class="flex justify-center md:justify-end col-span-12 md:col-span-4">
    <Text variant="subtitle" color="secondary">
      {t("Footer_switch_lang_text", undefined, lang)}
      <a href={esHref} class:list={[lang == "es" ? "text-primary-9" : null]}
        >{t("Footer_switch_lang_Spanish", undefined, lang)}</a
      > | <a href={enHref} class:list={[lang == "en" ? "text-primary-9" : null]}
        >{t("Footer_switch_lang_English", undefined, lang)}</a
      >
    </Text>
  </div>
</Container>
