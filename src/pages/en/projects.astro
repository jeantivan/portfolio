---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Heading from "@/components/Heading.astro";
import Container from "@/components/common/Container.astro";
import Text from "@/components/common/Text.astro";
import Project from "@/components/Project.astro";
import { type Locale, getPageSeo, t } from "@/i18n";

const lang: Locale = "en";
const seo = getPageSeo("projects", lang);

const enProjects = await getCollection(
  "project",
  ({ id, data }) => id.startsWith("en/") || data.language === "en",
);
const esProjects = await getCollection(
  "project",
  ({ id, data }) => id.startsWith("es/") || data.language === "es",
);

// Map each spanish project, replacing with english version if available for the same base name
const allProjects = esProjects.map((esProj) => {
  const baseSlug = esProj.id.split("/").pop();
  const matchingEn = enProjects.find((p) => p.id.split("/").pop() === baseSlug);
  return matchingEn ?? esProj;
});

const featuredProjects = allProjects.filter(
  (p) => p.data.featured && p.data.type !== "42",
);
const projectsFrom42 = allProjects.filter((p) => p.data.type === "42");
const otherProjects = allProjects.filter(
  (p) => !p.data.featured && p.data.type !== "42",
);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
>
  <Container class="grid gap-8 pt-4 py-6 md:pt-8 overflow-x-hidden relative">
    <section>
      <div class="mb-6 md:mb-8">
        <Heading
          text={t("ProjectsPage_main_title", undefined, lang)}
          as="h1"
          variant="title"
          class="mb-4"
          display
        />
        <Text color="secondary" variant="body3">
          {t("ProjectsPage_main_content", undefined, lang)}
        </Text>
      </div>
      <div class="grid gap-4 grid-cols-1 md:grid-cols-2">
        {featuredProjects.map((project) => <Project project={project} />)}
      </div>
    </section>

    <section>
      <div class="mb-6 md:mb-8">
        <Heading
          text={t("ProjectsPage_42_title", undefined, lang)}
          as="h1"
          variant="subheading"
          class="mb-4"
          display
        />
        <Text color="secondary" variant="body3">
          {t("ProjectsPage_42_content", undefined, lang)}
        </Text>
      </div>
      <div class="grid gap-4 grid-cols-2 md:grid-cols-3">
        {projectsFrom42.map((project) => <Project project={project} />)}
      </div>
    </section>

    <section class="grid gap-6">
      <div>
        <Heading
          text={t("ProjectsPage_smallProjects_title", undefined, lang)}
          as="h2"
          variant="heading"
          class="mb-4"
          display
        />
        <Text color="secondary" variant="body1">
          {t("ProjectsPage_smallProjects_content", undefined, lang)}
        </Text>
      </div>

      <div class="flex flex-wrap justify-center gap-4">
        {otherProjects.map((project) => <Project project={project} />)}
      </div>
    </section>

    <section>
      <Text color="secondary"
        >{t("ProjectsPage_extra_content", undefined, lang)}</Text
      >
    </section>
  </Container>
</BaseLayout>
