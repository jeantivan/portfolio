---
import { getEntry } from "astro:content";
import Container from "@/components/common/Container.astro";
import Heading from "@/components/Heading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/common/Text.astro";
import ButtonLink from "@/components/common/ButtonLink.astro";
import Icon from "@/components/common/Icon.astro";
import { type Locale, getPageSeo, t } from "@/i18n";

const lang: Locale = "en";
const seo = getPageSeo("contact", lang);

let author = await getEntry("authorInfo", "en/jeantivan");
if (!author) {
  author = await getEntry("authorInfo", "es/jeantivan");
}
const { email, linkedIn, github } = author?.data?.social ?? {
  email: "jeanpaultivan@gmail.com",
  linkedIn: "https://www.linkedin.com/in/jeantivan/",
  github: "https://github.com/jeantivan",
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
>
  <Container class="my-8 md:my-16 overflow-x-hidden max-w-full break-words">
    <section>
      <Heading
        text={t("ContactPage_title", undefined, lang)}
        as="h1"
        variant="title"
        display
        class="uppercase mb-4 text-center"
      />
      <Text variant="body3" color="secondary" class="mb-6 text-center">
        {t("ContactPage_subtitle", undefined, lang)}
      </Text>

      <a
        class="hover:underline decoration-primary-8 underline-offset-4"
        href={`mailto:${email}`}
      >
        <Heading text={email} variant="title" class="mb-8 text-center" />
      </a>

      <Text
        variant="body2"
        color="secondary"
        class="text-center"
        set:html={t(
          "ContactPage_socialCta",
          {
            linkedinUrl: linkedIn,
            githubUrl: github,
          },
          lang,
        )}
      />
      <div class="flex justify-center mt-12">
        <ButtonLink
          size="large"
          href={author?.data?.cv ? `${author.data.cv}?dl=` : "#"}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t("NavBar_cv", undefined, lang)}
          <Icon size="24px" label="Download" icon="download" />
        </ButtonLink>
      </div>
    </section>
  </Container>
</BaseLayout>
