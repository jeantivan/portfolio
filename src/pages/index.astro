---
import { getCollection, getEntries, getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import { type Locale, getPageSeo, localizePath, t } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/common/Container.astro";
import Text from "@/components/common/Text.astro";
import Icon from "@/components/common/Icon.astro";
import Card from "@/components/common/Card.astro";
import ButtonLink from "@/components/common/ButtonLink.astro";
import Heading from "@/components/Heading.astro";
import Skill from "@/components/Skill.astro";
import Project from "@/components/Project.astro";

const lang: Locale = "es";
const seo = getPageSeo("about", lang);

const latestFeaturedProjects = await getCollection(
  "project",
  ({ data, id }) => {
    const isSpanish = id.startsWith("es/") || data.language === "es";
    return isSpanish && data.featured && data.type !== "42";
  },
);

const author = await getEntry("authorInfo", "es/jeantivan");
const { Content } = author ? await render(author) : { Content: null };

const skillGroups = await getCollection(
  "skillGroup",
  ({ id }) => id.includes("the-main-stack") && id.startsWith("es"),
);
const mainStackGroup = skillGroups[0];
const mainStackTechs = mainStackGroup
  ? await getEntries(mainStackGroup.data.techs)
  : [];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
>
  <Container class="px-3 py-6 lg:py-10 grid gap-16 md:gap-24">
    <section>
      <div class="mb-4 flex flex-col md:flex-row gap-6">
        <div class="shrink-0 flex flex-col">
          <Text as="h1" variant="main" weight="bold" class="uppercase mb-2.5">
            Jean <br />Tivan
          </Text>
          <Text
            as="h2"
            variant="title"
            weight="medium"
            class="uppercase text-primary-11 dark:text-primary-9"
            display
          >
            {t("AboutMePage_main_title", undefined, lang)}
          </Text>
        </div>
      </div>
      <Text variant="subheading" weight="light" color="secondary">
        {t("AboutMePage_main_content", undefined, lang)}
      </Text>
    </section>

    <section class="grid gap-6 md:gap-8">
      <Heading
        text={t("AboutMePage_projects_title", undefined, lang)}
        as="h3"
        variant="title"
        class="flex-1 text-center"
      />
      <div class="flex flex-wrap justify-center gap-3">
        {latestFeaturedProjects.map((proj) => <Project project={proj} />)}
      </div>
      <div class="flex justify-center">
        <ButtonLink
          class="w-full max-w-lg"
          variant="outlined"
          href={localizePath("/projects", lang)}
        >
          {t("AboutMePage_projects_cta", undefined, lang)}
          <Icon label="Go to" icon="arrow-right" size="20px" />
        </ButtonLink>
      </div>
    </section>

    <section class="grid gap-6 md:gap-8">
      <Heading
        text={t("AboutMePage_skills_title", undefined, lang)}
        variant="heading"
        display
      />
      <div class="grid grid-cols-2 md:grid-cols-4 justify-between gap-3">
        {
          mainStackTechs.map((skill) => (
            <Card class="max-w-60 bg-background-2 px-8 py-4">
              <Skill size="auto" skill={skill} showName />
            </Card>
          ))
        }
      </div>
      <div class="flex justify-end">
        <ButtonLink
          variant="outlined"
          href={localizePath("/skills", lang)}
          class="w-full max-w-lg"
        >
          {t("AboutMePage_skills_cta", undefined, lang)}
          <Icon label="Arrow right icon" icon="arrow-right" size="20px" />
        </ButtonLink>
      </div>
    </section>

    <section class="grid grid-cols-11 gap-6 md:gap-10">
      <Heading
        class="col-span-11"
        text={t("AboutMePage_aboutMe_title", undefined, lang)}
        variant="heading"
        display
      />
      <div class="col-span-11 md:col-span-7">
        {Content && <Content components={{ p: Text }} />}
      </div>
      {
        author && (
          <div class="col-span-11 md:col-span-4 md:-mt-20">
            <div class="bg-background-9 rounded-xl w-full overflow-hidden">
              <Image
                src={author.data.picture.src}
                alt={author.data.picture.alt}
                class="w-full aspect-[4/5]"
              />
            </div>
          </div>
        )
      }

      <div class="col-span-11 flex justify-end">
        <ButtonLink href={localizePath("/contact", lang)}>
          {t("AboutMePage_aboutMe_cta", undefined, lang)}
        </ButtonLink>
      </div>
    </section>
  </Container>
</BaseLayout>
