{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@/assets/*": ["./src/assets/*"],
      "@/config/*": ["./src/config/*"],
      "@/components/*": ["./src/components/*"],
      "@/layouts/*": ["./src/layouts/*"],
      "@/styles/*": ["./src/styles/*"],
      "@/*": ["./src/*"],
      "@/i18n": ["./src/i18n/index.ts"],
      "@/i18n/*": ["./src/i18n/*"],
      "@/content/*": ["./src/content/*"]
    },
    "plugins": []
  }
}
